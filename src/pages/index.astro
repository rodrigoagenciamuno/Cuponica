---
import Base from '../layouts/Base.astro';
import CouponCard from '../components/CouponCard.astro';
import StoreLogo from '../components/StoreLogo.astro';
import { getFeaturedCoupons, getStores, getCategories } from '../lib/data';
import { monthYear, storeListSchema } from '../lib/seo';
import { daysLeft, expiryInfo, plural } from '../lib/ui';

const [all, stores, categories] = await Promise.all([getFeaturedCoupons(60), getStores(), getCategories()]);
// Faixa de lojas: destaques primeiro, completando com as que têm mais cupons.
const stripStores = [...stores]
  .filter((s) => (s.active_coupons ?? 0) > 0)
  .sort((a, b) => Number(b.featured) - Number(a.featured) || (b.active_coupons ?? 0) - (a.active_coupons ?? 0))
  .slice(0, 12);

// Destaques do topo: os quatro melhores cupons, de lojas diferentes.
const top: typeof all = [];
for (const c of all) {
  if (top.length === 4) break;
  if (c.discount_label && !top.some((f) => f.store_id === c.store_id)) top.push(c);
}
const gridStores = stripStores;
const updated = new Intl.DateTimeFormat('pt-BR', { day: 'numeric', month: 'long', timeZone: 'America/Sao_Paulo' }).format(new Date());
// Cupons de hoje: os melhores códigos e as melhores ofertas, misturados por prioridade.
const today = [
  ...all.filter((c) => c.type === 'code').slice(0, 11),
  ...all.filter((c) => c.type === 'deal').slice(0, 5),
].sort((a, b) => b.priority - a.priority);
const codes = today.filter((c) => c.type === 'code').length;
const ending = all
  .filter((c) => c.expires_at && daysLeft(c.expires_at) <= 3)
  .sort((a, b) => a.expires_at!.getTime() - b.expires_at!.getTime())
  .slice(0, 6);
// Descrição para o Google: cita a marca e as lojas com mais cupons (cresce sozinha com lojas novas).
const descStores = stripStores.filter((s) => !s.demo).slice(0, 4).map((s) => s.name);
const homeDescription = descStores.length >= 2
  ? `A Cuponica reúne cupons de desconto e ofertas verificadas de ${descStores.slice(0, -1).join(', ')} e ${descStores.at(-1)}, entre ${stores.length} lojas. Atualizado todos os dias, grátis e sem cadastro.`
  : 'A Cuponica reúne cupons de desconto e ofertas verificadas das principais lojas online do Brasil. Atualizado todos os dias, grátis e sem cadastro.';
const catCounts = new Map(categories.map((c) => [c.id, stores.filter((s) => s.categories.includes(c.id)).length]));

const siteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Cuponica',
  alternateName: 'Cuponica Cupons de Desconto',
  inLanguage: 'pt-BR',
  url: Astro.site!.toString(),
  publisher: { '@id': new URL('/#organization', Astro.site!).toString() },
  potentialAction: {
    '@type': 'SearchAction',
    target: new URL('/busca?q={q}', Astro.site!).toString().replace('%7Bq%7D', '{q}'),
    'query-input': 'required name=q',
  },
};
---
<Base
  title={`Cuponica: cupons de desconto válidos em ${monthYear()}`}
  description={homeDescription}
  path="/"
  jsonLd={[siteSchema, storeListSchema(Astro.site!, 'Lojas com cupons de desconto em destaque', stripStores.filter((s) => !s.demo))].filter(Boolean) as object[]}
  headerSearch={false}
>
  <section class="hero">
    <div class="wrap">
      <div class="hero-copy">
        <p class="hero-date">Atualizado hoje, {updated}</p>
        <h1>Cupons de desconto verificados das lojas que você usa.</h1>
        <p class="hero-lede">A Cuponica confere códigos e ofertas todos os dias. Sem cadastro e sem custo.</p>
        <form class="big-search" action="/busca" method="get" role="search" data-nosnippet>
          <label class="sr" for="busca-hero">Buscar loja</label>
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="8.5" cy="8.5" r="6"/><path d="M13 13l4.5 4.5" stroke-linecap="round"/></svg>
          <input id="busca-hero" type="search" name="q" placeholder="Busque uma loja" autocomplete="off" />
          <button class="btn" type="submit">Buscar</button>
        </form>
        <ul class="hero-trust">
          <li><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 8.5l3 3 6-7"/></svg>Cupons testados pela equipe</li>
          <li><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 8.5l3 3 6-7"/></svg>Link direto para a loja oficial</li>
          <li><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 8.5l3 3 6-7"/></svg>Grátis, sem cadastro</li>
        </ul>
      </div>
      {top.length > 0 && (
        <div class="hero-picks">
          <h2>Destaques de hoje</h2>
          <ul>
            {top.map((c) => (
              <li>
                <a href={`/cupom-desconto/${c.store.slug}#cupom-${c.id}`}>
                  <StoreLogo store={c.store} size={44} />
                  <span class="pick-text"><small>{c.store.name}</small><strong>{c.title}</strong></span>
                  <span class="pick-tag">{c.discount_label}</span>
                </a>
              </li>
            ))}
          </ul>
          <a class="hero-picks-all" href="#cupons-de-hoje">Ver todos os cupons de hoje</a>
        </div>
      )}
    </div>
  </section>

  {gridStores.length > 0 && (
    <section class="brands" aria-labelledby="h-lojas">
      <div class="wrap">
        <div class="section-head">
          <h2 id="h-lojas">Lojas em destaque</h2>
          <a href="/lojas">Ver todas as {stores.length} lojas</a>
        </div>
        <ul class="brand-grid">
          {gridStores.map((s) => (
            <li>
              <a href={`/cupom-desconto/${s.slug}`}>
                <StoreLogo store={s} size={72} />
                <span class="b-name">{s.name}</span>
                <strong class="b-best">{s.best_label ? `Até ${s.best_label}` : plural(s.active_coupons ?? 0, 'cupom', 'cupons')}</strong>
                <small class="b-count">{plural(s.active_coupons ?? 0, 'cupom ativo', 'cupons ativos')}</small>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <div class="wrap">
    <div class="home-grid section">
      <section class="filter-scope" aria-labelledby="h-hoje" id="cupons-de-hoje">
        <div class="section-head">
          <h2 id="h-hoje">Cupons de hoje</h2>
        </div>
        <div class="filter" role="radiogroup" aria-label="Filtrar cupons">
          <input type="radio" name="f-home" id="fh-all" class="f-all" checked /><label for="fh-all">Todos <span>{today.length}</span></label>
          <input type="radio" name="f-home" id="fh-code" class="f-code" /><label for="fh-code">Com código <span>{codes}</span></label>
          <input type="radio" name="f-home" id="fh-deal" class="f-deal" /><label for="fh-deal">Ofertas <span>{today.length - codes}</span></label>
        </div>
        <ul class="ticket-list">
          {today.map((c) => <CouponCard coupon={c} store={c.store} showStore />)}
        </ul>
      </section>

      <aside class="rail">
        {ending.length > 0 && (
          <div class="panel">
            <h2>Terminam em breve</h2>
            <ul class="ending">
              {ending.map((c) => (
                <li>
                  <a href={`/cupom-desconto/${c.store.slug}#cupom-${c.id}`}>
                    <StoreLogo store={c.store} />
                    <span><strong>{c.title}</strong><small>{expiryInfo(c.expires_at, false).text}</small></span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
        <div class="panel">
          <h2>Categorias</h2>
          <ul class="cat-list">
            {categories.map((c) => (
              <li><a href={`/categoria/${c.slug}`}>{c.name} <small>{catCounts.get(c.id)}</small></a></li>
            ))}
          </ul>
        </div>
        <div class="panel">
          <h2>Como usar um cupom</h2>
          <ol class="steps">
            <li><span><strong>Clique em Pegar cupom</strong>A loja abre em outra aba e o código já fica copiado.</span></li>
            <li><span><strong>Monte o carrinho</strong>Confira o valor mínimo e as regras na descrição.</span></li>
            <li><span><strong>Cole o código</strong>No campo de cupom, antes de pagar.</span></li>
          </ol>
        </div>
      </aside>
    </div>
  </div>
</Base>
