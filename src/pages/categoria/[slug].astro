---
import Base from '../../layouts/Base.astro';
import CouponCard from '../../components/CouponCard.astro';
import StoreCard from '../../components/StoreCard.astro';
import PageHead from '../../components/PageHead.astro';
import { getCategory, getStores, getStoreCoupons } from '../../lib/data';
import { breadcrumbSchema, monthYear, storeListSchema } from '../../lib/seo';

const category = await getCategory(String(Astro.params.slug));
if (!category) return Astro.rewrite('/404');

const stores = (await getStores())
  .filter((s) => s.categories.includes(category.id))
  .sort((a, b) => (b.active_coupons ?? 0) - (a.active_coupons ?? 0));
const couponLists = await Promise.all(stores.map((s) => getStoreCoupons(s.id)));
const coupons = couponLists
  .flat()
  .filter((c) => !c.expired)
  .sort((a, b) => b.priority - a.priority)
  .slice(0, 30)
  .map((c) => ({ coupon: c, store: stores.find((s) => s.id === c.store_id)! }));
const codes = coupons.filter((c) => c.coupon.type === 'code').length;

const path = `/categoria/${category.slug}`;
const crumbs = [{ name: 'Início', path: '/' }, { name: category.name, path }];
const onlyDemo = stores.length > 0 && stores.every((s) => s.demo);
---
<Base
  title={`Cupons de desconto em ${category.name} | ${monthYear()}`}
  description={`${category.intro ?? `Cupons de desconto em ${category.name}.`} ${stores.length} ${stores.length === 1 ? 'loja' : 'lojas'} e ${coupons.length} ${coupons.length === 1 ? 'oferta válida' : 'ofertas válidas'} hoje, atualizadas todo dia.`}
  path={path}
  jsonLd={[breadcrumbSchema(Astro.site!, crumbs), storeListSchema(Astro.site!, `Lojas de ${category.name} com cupom`, stores.filter((s) => !s.demo))].filter(Boolean) as object[]}
  section={path}
  noindex={onlyDemo}
>
  <PageHead title={`Cupons de ${category.name}`} lede={category.intro} crumbs={crumbs} />
  <div class="wrap">
    {stores.length > 0 && (
      <section>
        <h2>Lojas de {category.name}</h2>
        <ul class="store-grid">{stores.map((s) => <StoreCard store={s} />)}</ul>
      </section>
    )}

    <section class="section filter-scope">
      <h2>Melhores cupons de {category.name}</h2>
      {coupons.length > 0 ? (
        <>
          {codes > 0 && codes < coupons.length && (
            <div class="filter" role="radiogroup" aria-label="Filtrar cupons">
              <input type="radio" name="f-cat" id="fc-all" class="f-all" checked /><label for="fc-all">Todos <span>{coupons.length}</span></label>
              <input type="radio" name="f-cat" id="fc-code" class="f-code" /><label for="fc-code">Com código <span>{codes}</span></label>
              <input type="radio" name="f-cat" id="fc-deal" class="f-deal" /><label for="fc-deal">Ofertas <span>{coupons.length - codes}</span></label>
            </div>
          )}
          <ul class="ticket-list" style="max-width:880px">{coupons.map(({ coupon, store }) => <CouponCard coupon={coupon} store={store} showStore />)}</ul>
        </>
      ) : (
        <div class="empty"><p class="muted" style="margin:0">Nenhum cupom ativo nesta categoria agora. Veja a <a href="/lojas">lista de lojas</a>.</p></div>
      )}
    </section>
  </div>
</Base>
