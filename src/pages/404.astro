---
import Base from '../layouts/Base.astro';
Astro.response.status = 404;
---
<Base title="Página não encontrada" description="A página que você procurou não existe." noindex>
  <div class="hero">
    <h1>Página não encontrada</h1>
    <p>Talvez a loja tenha mudado de endereço. Veja a <a href="/lojas">lista completa de lojas</a> ou volte para a <a href="/">página inicial</a>.</p>
  </div>
</Base>
