---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
Astro.response.status = 404;
---
<Base title="Página não encontrada" description="A página que você procurou não existe." noindex>
  <PageHead title="Página não encontrada" lede="A loja pode ter mudado de endereço. Busque pelo nome no topo da página ou veja todas as lojas." />
  <div class="wrap"><a class="btn" href="/lojas">Ver lojas de A a Z</a></div>
</Base>
