---
import Base from '../layouts/Base.astro';
import StoreCard from '../components/StoreCard.astro';
import PageHead from '../components/PageHead.astro';
import { getStores } from '../lib/data';
import { breadcrumbSchema } from '../lib/seo';

const stores = await getStores();
const groups = new Map<string, typeof stores>();
for (const s of stores) {
  const letter = s.name.normalize('NFD').replace(/[̀-ͯ]/g, '').charAt(0).toUpperCase();
  const key = /[A-Z]/.test(letter) ? letter : '#';
  groups.set(key, [...(groups.get(key) || []), s]);
}
const letters = [...groups.keys()].sort();
const crumbs = [{ name: 'Início', path: '/' }, { name: 'Lojas de A a Z', path: '/lojas' }];
---
<Base
  title="Todas as lojas com cupom de desconto"
  description={`Lista completa das ${stores.length} lojas com cupons de desconto na Cuponica, de A a Z.`}
  path="/lojas"
  jsonLd={breadcrumbSchema(Astro.site!, crumbs)}
  section="/lojas"
>
  <PageHead title="Lojas de A a Z" lede={`${stores.length} lojas com cupons e ofertas.`} crumbs={crumbs} />
  <div class="wrap">
    <nav class="letters" aria-label="Ir para a letra">
      {letters.map((l) => <a href={`#letra-${l}`}>{l}</a>)}
    </nav>
    {letters.map((l) => (
      <section class="letter-block" id={`letra-${l}`}>
        <h2>{l}</h2>
        <ul class="store-grid">{groups.get(l)!.map((s) => <StoreCard store={s} />)}</ul>
      </section>
    ))}
  </div>
</Base>
