---
import type { Store } from '../lib/data';
import { initials, onColor } from '../lib/ui';

interface Props { store: Pick<Store, 'name' | 'logo_url' | 'brand_color'>; size?: number; class?: string }
const { store, size, class: cls } = Astro.props;
const color = store.brand_color || '#4f2ef0';
const style = [`--brand:${color}`, size ? `--size:${size}px` : ''].filter(Boolean).join(';');
---
<span class:list={['slogo', cls, { 'on-light': !store.logo_url && onColor(color) === 'dark' }]} style={style} aria-hidden="true">
  {store.logo_url ? <img src={store.logo_url} alt="" loading="lazy" width={size || 44} height={size || 44} /> : initials(store.name)}
</span>
