---
import type { Coupon, Store } from '../lib/data';
import StoreLogo from './StoreLogo.astro';
import { daysLeft, expiryInfo, onColor, splitLabel } from '../lib/ui';

interface Props {
  coupon: Coupon;
  store: Store;
  /** Mostra a loja no card (home, categoria, busca). */
  showStore?: boolean;
}
const { coupon, store, showStore = false } = Astro.props;
const goUrl = `/ir/${coupon.id}?p=${encodeURIComponent(Astro.url.pathname)}`;
const label = splitLabel(coupon.discount_label, coupon.type);
const exp = expiryInfo(coupon.expires_at, coupon.expired);
const brand = store.brand_color || '#4f2ef0';
const onBrand = onColor(brand) === 'dark' ? '#16123a' : '#ffffff';
// Contagem regressiva ao vivo só para quem termina hoje ou amanhã.
const live = !coupon.expired && coupon.expires_at && daysLeft(coupon.expires_at) <= 1 ? coupon.expires_at.toISOString() : null;
---
<li
  class:list={['ticket', { 'is-expired': coupon.expired, 'is-exclusive': coupon.exclusive && !coupon.expired }]}
  id={`cupom-${coupon.id}`}
  data-type={coupon.type}
  style={`--brand:${brand};--on-brand:${onBrand}`}
>
  {coupon.exclusive && !coupon.expired && (
    <span class="ribbon"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 1.5l1.9 4 4.3.5-3.2 3 .9 4.3L8 11.2l-3.9 2.1.9-4.3-3.2-3 4.3-.5z" fill="currentColor"/></svg>Exclusivo Cuponica</span>
  )}

  <div class="ticket-stub">
    <div class:list={['disc', `disc-${label.kind}`]}>
      {label.kind === 'money' && <span class="disc-pre">R$</span>}
      <span class="disc-num">{label.big}</span>
      {label.kind === 'pct' && <span class="disc-suf">{label.small}</span>}
      {label.kind === 'money' && <span class="disc-suf">OFF</span>}
    </div>
    <span class="stub-type">{coupon.type === 'code' ? 'Cupom' : 'Oferta'}</span>
  </div>

  <div class="ticket-body">
    {showStore && (
      <a class="ticket-store" href={`/cupom-desconto/${store.slug}`}><StoreLogo store={store} size={22} />{store.name}</a>
    )}
    <h3>{coupon.title}</h3>
    {coupon.description && <p>{coupon.description}</p>}
    <div class="ticket-meta">
      {coupon.verified && !coupon.expired && (
        <span class="meta-ok"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.5 8.5l3 3 6-7"/></svg>Verificado</span>
      )}
      <span class:list={['meta-exp', { 'is-hot': exp.hot }]} data-expires={live}>
        {exp.hot && !coupon.expired
          ? <i class="pulse" aria-hidden="true"></i>
          : <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="8" cy="8" r="6"/><path d="M8 4.8V8l2.2 1.4"/></svg>}
        <span class="exp-text">{exp.text}</span>
      </span>
    </div>
  </div>

  <div class="ticket-action">
    {coupon.expired ? (
      <p class="expired-note">Este cupom expirou</p>
    ) : coupon.type === 'code' && coupon.code ? (
      <>
        <a class="peel" href={goUrl} target="_blank" rel="sponsored nofollow noopener" data-reveal aria-label={`Pegar cupom: ${coupon.title}`}>
          <span class="peel-code" aria-hidden="true">{coupon.code}</span>
          <span class="peel-cover"><span>Pegar cupom</span></span>
        </a>
        <div class="code-box">
          <strong>{coupon.code}</strong>
          <button type="button" data-copy={coupon.code}>Copiar</button>
        </div>
        <p class="code-status" aria-live="polite"></p>
        <noscript><div class="code-box" style="display:flex"><strong>{coupon.code}</strong></div></noscript>
      </>
    ) : (
      <a class="deal-btn" href={goUrl} target="_blank" rel="sponsored nofollow noopener">
        Ver oferta na loja
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h7v7M13 3L4 12"/></svg>
      </a>
    )}
  </div>
</li>
