---
import Breadcrumbs from './Breadcrumbs.astro';
interface Props { title: string; lede?: string | null; crumbs?: { name: string; path: string }[] }
const { title, lede, crumbs } = Astro.props;
---
<section class="page-head">
  <div class="wrap">
    {crumbs && <Breadcrumbs items={crumbs} />}
    <h1>{title}</h1>
    {lede && <p>{lede}</p>}
    <slot />
  </div>
</section>
