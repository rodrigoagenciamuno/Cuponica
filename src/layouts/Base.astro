---
import '@fontsource-variable/geist/wght.css';
import '@fontsource-variable/geist-mono/wght.css';
import '../styles/global.css';
import { getCategories, getStores } from '../lib/data';
import { organizationSchema, siteConfig } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  /** Caminho canônico (ex.: /cupom-desconto/loja). Sem query string. */
  path?: string;
  noindex?: boolean;
  jsonLd?: object | object[];
  ogImage?: string;
  /** Item do menu a marcar como atual. */
  section?: string;
  /** Texto já digitado na busca do cabeçalho. */
  q?: string;
  /** Busca no cabeçalho. Desligada na home, que já tem a busca principal no topo. */
  headerSearch?: boolean;
}

const { title, description, path, noindex = false, jsonLd, ogImage, section, q = '', headerSearch = true } = Astro.props;
const nav = [
  ['/lojas', 'Lojas'],
  ['/categorias', 'Categorias'],
  ['/como-funciona', 'Como funciona'],
];
// Rodapé: categorias e lojas com mais cupons (dados em cache, não pesa na página).
const [footCats, footStores] = await Promise.all([getCategories(), getStores()]);
const topStores = [...footStores].sort((a, b) => (b.active_coupons ?? 0) - (a.active_coupons ?? 0)).slice(0, 6);
const site = Astro.site!;
const canonical = new URL(path ?? Astro.url.pathname, site).toString();
const fullTitle = title.includes('Cuponica') ? title : `${title} | Cuponica`;
const schemas = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const orgSchema = organizationSchema(site);
const cfg = siteConfig();
const og = new URL(ogImage || '/og/cuponica.png', site).toString();
// Consent Mode v2 (LGPD): tudo negado até o visitante aceitar. A escolha fica no cookie cp_consent.
const gtmHead = cfg.gtmId
  ? `window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}
var c=(document.cookie.match(/(?:^|; )cp_consent=([^;]*)/)||[])[1];var g=c==='granted'?'granted':'denied';
gtag('consent','default',{ad_storage:g,analytics_storage:g,ad_user_data:g,ad_personalization:g,functionality_storage:'granted',security_storage:'granted',wait_for_update:500});
gtag('set','url_passthrough',true);gtag('set','ads_data_redaction',g==='denied');
(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',${JSON.stringify(cfg.gtmId)});`
  : '';
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex
      ? <meta name="robots" content="noindex, follow" />
      : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Cuponica" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Cuponica: cupons de desconto verificados" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <meta name="theme-color" content="#16123a" />
    <link rel="alternate" hreflang="pt-BR" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="text/markdown" title="Cuponica para IAs" href="/llms.txt" />
    {cfg.googleVerification && <meta name="google-site-verification" content={cfg.googleVerification} />}
    {cfg.bingVerification && <meta name="msvalidate.01" content={cfg.bingVerification} />}
    {cfg.gtmId && <link rel="preconnect" href="https://www.googletagmanager.com" />}
    {cfg.gtmId && <script is:inline set:html={gtmHead} />}
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    {cfg.gtmId && <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${cfg.gtmId}`} height="0" width="0" style="display:none;visibility:hidden" title="GTM"></iframe></noscript>}
    <header class="site-header">
      <div class="wrap">
        <a class="logo" href="/" aria-label="Cuponica, página inicial">
          <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M6 4h20a2 2 0 0 1 2 2v6a4 4 0 0 0 0 8v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-6a4 4 0 0 0 0-8V6a2 2 0 0 1 2-2z" fill="#ffe03d"/><path d="M12.5 21.5l7-11" stroke="#16123a" stroke-width="2.4" stroke-linecap="round"/><circle cx="12" cy="12" r="2.2" fill="#16123a"/><circle cx="20" cy="20" r="2.2" fill="#16123a"/></svg>
          <span>cuponica</span>
        </a>
        <nav class="nav" aria-label="Principal">
          {nav.map(([href, label]) => <a href={href} aria-current={section === href ? 'page' : undefined}>{label}</a>)}
        </nav>
        {headerSearch ? (
          <form class="head-search" action="/busca" method="get" role="search">
            <label class="sr" for="busca-topo">Buscar loja</label>
            <input id="busca-topo" type="search" name="q" value={q} placeholder="Buscar loja" autocomplete="off" />
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="8.5" cy="8.5" r="6"/><path d="M13 13l4.5 4.5" stroke-linecap="round"/></svg>
          </form>
        ) : (
          <a class="head-search-link" href="/busca" aria-label="Buscar loja">
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="8.5" cy="8.5" r="6"/><path d="M13 13l4.5 4.5" stroke-linecap="round"/></svg>
          </a>
        )}
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="foot-top">
        <div class="wrap foot-grid">
          <div class="foot-brand">
            <a class="logo" href="/" aria-label="Cuponica, página inicial">
              <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M6 4h20a2 2 0 0 1 2 2v6a4 4 0 0 0 0 8v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-6a4 4 0 0 0 0-8V6a2 2 0 0 1 2-2z" fill="#ffe03d"/><path d="M12.5 21.5l7-11" stroke="#16123a" stroke-width="2.4" stroke-linecap="round"/><circle cx="12" cy="12" r="2.2" fill="#16123a"/><circle cx="20" cy="20" r="2.2" fill="#16123a"/></svg>
              <span>cuponica</span>
            </a>
            <p>Cupons de desconto e ofertas das principais lojas online do Brasil, conferidos e atualizados todos os dias.</p>
            <ul class="foot-trust">
              <li>Grátis, sem cadastro</li>
              <li>Cupons conferidos todos os dias</li>
              <li>Links seguros para a loja oficial</li>
            </ul>
          </div>
          <nav aria-labelledby="f-cuponica">
            <h2 id="f-cuponica">Cuponica</h2>
            <ul>
              <li><a href="/sobre">Quem somos</a></li>
              <li><a href="/como-funciona">Como funciona</a></li>
              <li><a href="/privacidade">Privacidade</a></li>
            </ul>
          </nav>
          <nav aria-labelledby="f-cupons">
            <h2 id="f-cupons">Cupons</h2>
            <ul>
              <li><a href="/lojas">Lojas de A a Z</a></li>
              <li><a href="/categorias">Todas as categorias</a></li>
              <li><a href="/busca">Buscar loja</a></li>
            </ul>
          </nav>
          <nav aria-labelledby="f-cats">
            <h2 id="f-cats">Categorias</h2>
            <ul>{footCats.slice(0, 6).map((c) => <li><a href={`/categoria/${c.slug}`}>{c.name}</a></li>)}</ul>
          </nav>
          {topStores.length > 0 && (
            <nav aria-labelledby="f-lojas">
              <h2 id="f-lojas">Lojas em alta</h2>
              <ul>{topStores.map((s) => <li><a href={`/cupom-desconto/${s.slug}`}>Cupom {s.name}</a></li>)}</ul>
            </nav>
          )}
        </div>
      </div>
      <div class="foot-bottom">
        <div class="wrap">
          <p>© {new Date().getFullYear()} Cuponica. Todos os direitos reservados.</p>
          <p>A Cuponica pode receber comissão quando você compra pelos links do site. Isso não muda o preço que você paga. As condições de cada cupom são definidas pela loja.</p>
          <a class="to-top" href="#">Voltar ao topo</a>
        </div>
      </div>
    </footer>
    <div class="toast" role="status" aria-live="polite"></div>
    {cfg.gtmId && (
      <div class="consent" id="consent" role="dialog" aria-label="Cookies" hidden>
        <p>Usamos cookies para medir o uso do site e melhorar os anúncios. Você escolhe. <a href="/privacidade">Saiba mais</a></p>
        <div class="consent-actions">
          <button type="button" class="btn btn-line" data-consent="denied">Recusar</button>
          <button type="button" class="btn" data-consent="granted">Aceitar</button>
        </div>
      </div>
    )}
    <script is:inline>
      /* Único JavaScript do site. "Pegar cupom" abre a loja em nova aba (via /ir/, com tracking)
         e nesta aba revela e copia o código. */
      (function () {
        var toast = document.querySelector('.toast'), t;
        function say(msg) {
          if (!toast) return;
          toast.textContent = msg; toast.classList.add('show');
          clearTimeout(t); t = setTimeout(function () { toast.classList.remove('show'); }, 2600);
        }
        function copy(code, card) {
          var status = card && card.querySelector('.code-status');
          var btn = card && card.querySelector('[data-copy]');
          var done = function () {
            if (status) status.textContent = 'Código copiado. Cole no carrinho da loja.';
            if (btn) { btn.textContent = 'Copiado'; btn.classList.add('done'); }
            say('Código ' + code + ' copiado');
            track('coupon_copy', card);
          };
          if (navigator.clipboard) navigator.clipboard.writeText(code).then(done, function () { if (status) status.textContent = 'Selecione o código e copie.'; });
          else if (status) status.textContent = 'Selecione o código e copie.';
        }
        /* Eventos para o Google Tag Manager (GA4 / Google Ads). Sem GTM, dataLayer só acumula. */
        var dl = window.dataLayer = window.dataLayer || [];
        function track(name, el, extra) {
          var card = el && el.closest && el.closest('[data-coupon]');
          var ev = { event: name, page_path: location.pathname };
          if (card) { ev.coupon_id = card.getAttribute('data-coupon'); ev.store = card.getAttribute('data-store'); ev.coupon_type = card.getAttribute('data-type'); }
          for (var k in extra || {}) if (extra[k] != null) ev[k] = extra[k];
          dl.push(ev);
        }
        document.addEventListener('click', function (e) {
          var a = e.target.closest && e.target.closest('a[href^="/ir/"]');
          if (a) track(a.hasAttribute('data-reveal') ? 'coupon_reveal' : 'outbound_click', a, { store: a.getAttribute('data-store') || undefined });
        }, true);
        /* Consentimento (LGPD + Consent Mode v2) */
        var box = document.getElementById('consent');
        if (box) {
          if (!/(?:^|; )cp_consent=/.test(document.cookie)) box.hidden = false;
          box.addEventListener('click', function (e) {
            var b = e.target.closest && e.target.closest('[data-consent]');
            if (!b) return;
            var v = b.getAttribute('data-consent');
            document.cookie = 'cp_consent=' + v + ';path=/;max-age=' + 60 * 60 * 24 * 180 + ';samesite=lax';
            if (window.gtag) gtag('consent', 'update', { ad_storage: v, analytics_storage: v, ad_user_data: v, ad_personalization: v });
            dl.push({ event: 'consent_' + v });
            box.hidden = true;
          });
        }
        document.addEventListener('click', function (e) {
          var el = e.target.closest && e.target.closest('[data-reveal], [data-copy]');
          if (!el) return;
          var card = el.closest('.ticket');
          if (el.hasAttribute('data-copy')) return copy(el.getAttribute('data-copy'), card);
          if (!card) return;
          card.classList.add('revealed');
          var btn = card.querySelector('[data-copy]');
          if (btn) { copy(btn.getAttribute('data-copy'), card); btn.focus({ preventScroll: true }); }
        });
        /* Contagem regressiva dos cupons que terminam hoje ou amanhã */
        var timers = [].slice.call(document.querySelectorAll('[data-expires]'));
        if (timers.length) {
          var pad = function (n) { return n < 10 ? '0' + n : '' + n; };
          var tick = function () {
            var now = Date.now();
            timers.forEach(function (el) {
              var left = Math.max(0, Date.parse(el.getAttribute('data-expires')) - now);
              var h = Math.floor(left / 36e5), m = Math.floor(left % 36e5 / 6e4), s = Math.floor(left % 6e4 / 1e3);
              var out = el.querySelector('.exp-text');
              if (out) out.textContent = left ? 'Termina em ' + pad(h) + ':' + pad(m) + ':' + pad(s) : 'Encerrado';
            });
          };
          tick(); setInterval(tick, 1000);
        }
      })();
    </script>
  </body>
</html>
