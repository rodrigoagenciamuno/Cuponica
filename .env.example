# Copie para .env no seu computador, ou cadastre estas variáveis no painel da Hostinger
# (app Node.js → Variáveis de ambiente).

# URL pública do site (sem barra no final)
SITE_URL=https://cuponica.com.br

# Banco MySQL (hPanel → Bancos de dados). Sem isso, o site roda com dados fictícios.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Rakuten Advertising (portal de desenvolvedores)
RAKUTEN_TOKEN_KEY=
RAKUTEN_SID=
# ID de publisher usado no deeplink (click.linksynergy.com/deeplink?id=...)
RAKUTEN_PUBLISHER_ID=
# Opcional: filtra o feed de cupons por rede (país)
RAKUTEN_NETWORK=

# Senha do painel /admin
ADMIN_PASSWORD=

# Chave dos endpoints de Cron (/api/cron/...). Texto aleatório com 16+ caracteres.
CRON_KEY=

# Sal usado para anonimizar o IP dos cliques (troque por um texto aleatório)
IP_HASH_SALT=troque-isto

# ---------- Marketing e SEO (todas opcionais) ----------
# Google Tag Manager (GTM-XXXXXXX). GA4 e Google Ads são configurados dentro do GTM.
GTM_ID=
# Search Console: só o código do content da meta google-site-verification
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools: código do content da meta msvalidate.01
BING_SITE_VERIFICATION=
# ads.txt (Google Ad Manager/AdSense). Várias linhas separadas por ;
ADS_TXT=
# Perfis oficiais da marca, separados por vírgula (vão no schema Organization)
SOCIAL_LINKS=
# E-mail de contato exibido em Quem somos e Privacidade
CONTACT_EMAIL=

# Tempo de cache das páginas em memória, em segundos
CACHE_TTL_SECONDS=300
